# OpenAI API key — https://platform.openai.com/api-keys
# Powers the chat/RAG (gpt-5.4-mini), embeddings (text-embedding-3-small),
# and CV photo generation (gpt-image-2).
OPENAI_API_KEY=your_key_here

# Google AI Studio key — https://aistudio.google.com/apikey
# Used for CV profile-text generation, and as an image-gen fallback.
GEMINI_API_KEY=your_key_here

# Models (defaults are fine)
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# How many CVs to generate (task asks for 25-30)
CV_COUNT=28
